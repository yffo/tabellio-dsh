{
  "name": "tabellio-dsh",
  "version": "0.1.3",
  "description": "DeepSeek Harness native adapter for tabellio: budgeted auto-recall, native memory tools, and explicit-clue candidates. The memory core stays in tabellio.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tabellio",
    "memory",
    "markdown"
  ],
  "author": "yffto",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "files": [
    "docs/",
    "index.js",
    "client/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20.11.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "tabellio": "0.1.5"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "acceptance": "node tests/acceptance.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yffo/tabellio-dsh.git"
  },
  "homepage": "https://github.com/yffo/tabellio-dsh#readme",
  "bugs": {
    "url": "https://github.com/yffo/tabellio-dsh/issues"
  }
}
